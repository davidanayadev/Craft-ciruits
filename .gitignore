# Godot editor cache and import output (regenerated by `--import`).
# Also holds export_credentials.cfg, where Godot 4 stores keystore passwords.
game/.godot/

# Exported builds (APK, AAB, EXE).
builds/

# JUnit report written by GUT on every test run (game/.gutconfig.json).
game/test_results.xml

# Signing material never belongs in the repo (R-001-12).
*.keystore
*.jks
export_credentials.cfg
